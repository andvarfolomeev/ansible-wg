server {
    listen 127.0.0.1:{{ cover_site_port }} ssl http2 default_server;
    server_name {{ cover_site_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ cover_site_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ cover_site_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root {{ cover_site_root }};
    index index.html;
{% for location in cover_site_plain_text_locations %}

    location {{ location }} {
        default_type text/plain;
    }
{% endfor %}
}
