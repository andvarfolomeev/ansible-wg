{
  "log": {
{# The access log goes to journald, where only the dashboard reads it; it names every client and destination #}
{% if xray_dashboard_address | length == 0 %}
    "access": "none",
{% endif %}
    "loglevel": "{{ xray_log_level }}"
  },
  "stats": {},
  "api": {
    "tag": "api",
    "listen": "{{ xray_api_listen }}",
    "services": ["StatsService", "HandlerService"]
  },
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    }
  },
  "inbounds": [
    {
      "tag": "vision",
      "listen": "0.0.0.0",
      "port": {{ xray_server.port }},
      "protocol": "vless",
      "settings": {
        "clients": [
{% for client in xray_clients %}
          {
            "id": "{{ client.uuid }}",
            "email": "{{ client.name }}",
            "flow": "{{ xray_client_flow }}"
          }{% if not loop.last %},{% endif %}

{% endfor %}
        ],
        "decryption": "none",
        "fallbacks": [
          {
            "dest": "{{ xray_xhttp_socket }}"
          }
        ]
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "target": "127.0.0.1:{{ xray_site_port }}",
          "xver": {{ xray_site_xver | int }},
          "serverNames": [
            "{{ xray_server.domain }}"
          ],
          "privateKey": "{{ xray_server.private_key }}",
          "shortIds": [
{% for client in xray_clients %}
            "{{ client.short_id }}"{% if not loop.last %},{% endif %}

{% endfor %}
          ]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      }
    },
    {
      "tag": "xhttp",
      "listen": "{{ xray_xhttp_socket }}",
      "protocol": "vless",
      "settings": {
        "clients": [
{% for client in xray_clients %}
          {
            "id": "{{ client.uuid }}",
            "email": "{{ client.name }}"
          }{% if not loop.last %},{% endif %}

{% endfor %}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {
          "mode": "auto",
          "path": "{{ xray_server.xhttp_path }}"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      }
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
{# Keeps clients away from services on the server itself, such as the Xray API and the dashboard #}
      {
        "ruleTag": "block-private",
        "type": "field",
        "ip": ["geoip:private"],
        "outboundTag": "block"
      },
{% if xray_blocked_ads %}
      {
        "type": "field",
        "domain": {{ xray_blocked_ads | to_json }},
        "outboundTag": "block"
      },
{% endif %}
      {
        "type": "field",
        "domain": {{ xray_blocked_domains | to_json }},
        "outboundTag": "block"
      },
      {
        "type": "field",
        "ip": {{ xray_blocked_ips | to_json }},
        "outboundTag": "block"
      }
    ]
  },
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ]
}
